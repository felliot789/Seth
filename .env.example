# Use a vision-capable model exposed by your provider.
# api (default) or web (Lightpanda). Local session setup is described in README.md.
INFERENCE_BACKEND=api
# Both a base URL ending in /v1 and a full /chat/completions URL are accepted.
INFERENCE_BASE_URL=https://api.openai.com/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=
