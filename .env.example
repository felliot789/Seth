# Copy to .env beside config.json and fill in your provider's values.
# Use a vision-capable model at a compatible chat-completions endpoint.
# A base URL ending in /v1 or a full /chat/completions URL is accepted.
# Environment variables override .env. Do not commit credentials.
INFERENCE_BASE_URL=https://your-provider.example/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=
