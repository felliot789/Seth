[Unit]
Description=Seth keyboard shortcuts and host status indicator
PartOf=seth.target graphical-session.target
After=graphical-session-pre.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=@ROOT@
ExecStart=@PYTHON@ @MAIN@ --config @CONFIG@ --mode listen --execute --hotkey --overlay
Environment=PYTHONUNBUFFERED=1 SETH_MANAGED_BROWSER=1
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=270

[Install]
WantedBy=seth.target
